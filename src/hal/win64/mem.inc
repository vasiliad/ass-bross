; =============================================================================
; hal/win64/mem.inc — виртуальная память: резервирование, фиксация, возврат ОС.
; Единственное место, где арены обращаются к VirtualAlloc/VirtualFree.
; =============================================================================

NW_MEM_COMMIT       = 0x1000
NW_MEM_RESERVE      = 0x2000
NW_MEM_DECOMMIT     = 0x4000
NW_MEM_RELEASE      = 0x8000
NW_PAGE_READWRITE   = 0x04

; -----------------------------------------------------------------------------
; sys_mem_reserve — зарезервировать диапазон адресов без расхода физической памяти.
;   rcx = размер в байтах
;   Результат: rax = адрес или 0
; -----------------------------------------------------------------------------
proc sys_mem_reserve uses rbx
        mov     rbx, rcx
        invoke  VirtualAlloc, 0, rbx, NW_MEM_RESERVE, NW_PAGE_READWRITE
        ret
endp

; -----------------------------------------------------------------------------
; sys_mem_commit — зафиксировать страницы внутри зарезервированного диапазона
; (ОС отдаёт нулевые страницы).
;   rcx = адрес (кратен 4 КБ), rdx = размер
;   Результат: rax = 1 / 0
; -----------------------------------------------------------------------------
proc sys_mem_commit uses rbx rsi
        mov     rbx, rcx
        mov     rsi, rdx
        invoke  VirtualAlloc, rbx, rsi, NW_MEM_COMMIT, NW_PAGE_READWRITE
        test    rax, rax
        setnz   al
        movzx   eax, al
        ret
endp

; -----------------------------------------------------------------------------
; sys_mem_decommit — вернуть физическую память, оставив адреса зарезервированными.
;   rcx = адрес, rdx = размер
; -----------------------------------------------------------------------------
proc sys_mem_decommit uses rbx rsi
        mov     rbx, rcx
        mov     rsi, rdx
        invoke  VirtualFree, rbx, rsi, NW_MEM_DECOMMIT
        ret
endp

; -----------------------------------------------------------------------------
; sys_mem_release — освободить весь зарезервированный диапазон.
;   rcx = базовый адрес, возвращённый sys_mem_reserve
; -----------------------------------------------------------------------------
proc sys_mem_release uses rbx
        mov     rbx, rcx
        invoke  VirtualFree, rbx, 0, NW_MEM_RELEASE
        ret
endp
